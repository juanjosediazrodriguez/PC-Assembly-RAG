# Configuración del proveedor de LLM para la generación del manual
# Opciones recomendadas: NVIDIA API (gratis) o Groq (gratis)

# Proveedor activo: 'nvidia' o 'groq'
LLM_PROVIDER=nvidia

# Llave de API para NVIDIA (https://build.nvidia.com/)
NVIDIA_API_KEY=nvapi-tu_api_key_aqui
# Los modelos gratuitos cambian, y algunos aparecen en la lista de la cuenta pero devuelven 404.
# Antes de elegir uno, haz una llamada corta de prueba. Con este funcionó el 2026-11-12.
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Alternativa: Llave de API para Groq (https://console.groq.com/)
GROQ_API_KEY=gsk_tu_api_key_aqui
GROQ_MODEL=llama-3.3-70b-versatile

# Configuración de ChromaDB (almacenamiento local)
CHROMA_PERSIST_DIRECTORY=data/vectorstore
CHROMA_COLLECTION_NAME=pc_manuals
