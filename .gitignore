# Entornos virtuales de Python
.venv/
venv/
ENV/
env/

# Caché de Python
__pycache__/
*.py[cod]
*$py.class
*.pytest_cache/
.coverage
htmlcov/

# Variables de entorno y secretos
.env
.env.local
*.key
*.pem

# Base de datos vectorial persistente (ChromaDB)
data/vectorstore/

# Fragmentos generados por scripts/ingest_manuals.py (se regeneran con ese comando)
data/processed/manual_chunks.jsonl

# Archivos pesados de datos crudos (manuales PDF)
# En escalabilidad o produccion con miles de manuales NO se suben binarios a Git.
# Para el MVP se habilita como excepcion el manual de referencia oficial:
data/raw/manuals_pdf/*.pdf
!data/raw/manuals_pdf/E21902_TUF_GAMING_B650-PLUS_WIFI_UM_V3_WEB.pdf
!data/raw/manuals_pdf/.gitkeep

# Archivos temporales o logs
*.log
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
